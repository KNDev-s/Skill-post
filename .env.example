# mock = demonstração local; api = backend real. Sem fallback silencioso.
VITE_SERVICE_MODE=mock
# Inclua o prefixo de versão. Aceita URL absoluta ou /api/v1 na mesma origem.
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=30000
VITE_POLL_INTERVAL_MS=2000
# same-origin ou include (cookies entre origens; requer CORS explícito no backend).
VITE_API_CREDENTIALS=same-origin
# Nunca coloque tokens OpenAI/Meta/Cloudflare em VITE_*: tudo vai para o navegador.
