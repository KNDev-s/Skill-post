PORT=3001
BASE_URL=http://127.0.0.1:3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Chave da OpenAI GPT (obtenha em https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Chave do Google Gemini (opcional, caso queira alternar)
GEMINI_API_KEY=

# Tokens da Meta Graph API (Instagram)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Facebook Login: graph.facebook.com; Instagram Login: graph.instagram.com
INSTAGRAM_API_HOST=graph.facebook.com
